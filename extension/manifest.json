{
  "manifest_version": 3,
  "name": "Vids Studio — управление выбранным видео",
  "version": "0.3.0",
  "description": "Локальный мост Codex для одной явно подключённой вкладки Google Vids.",
  "minimum_chrome_version": "118",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vids Studio"
  },
  "key": ""
}
